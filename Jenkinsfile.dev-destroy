// Destroys the DEV environment every evening to save money.
// Hard-coded to envs/dev: it can never touch stage or prod.

pipeline {
    agent any

    triggers {
        cron('''TZ=Europe/Berlin
H 21 * * *''')                                 // every evening around 21:xx Berlin time
    }

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        TF_IN_AUTOMATION    = 'true'
        TF_INPUT            = '0'
        AWS_REGION          = 'eu-central-1'
        TF_PLUGIN_CACHE_DIR = '/var/lib/jenkins/.terraform.d/plugin-cache'
    }
    stage('Remove Kubernetes load balancers') {
            steps {
                script {
                    // Is there a dev cluster at all? (exit code 0 = yes)
                    def clusterExists = sh(script: 'aws eks describe-cluster --name dev-eks --region $AWS_REGION > /dev/null 2>&1',
                                           returnStatus: true) == 0
                    if (!clusterExists) {
                        echo 'No dev cluster - nothing to clean up.'
                    } else {
                        sh '''
                          # Separate kubeconfig, only for this build
                          export KUBECONFIG="$WORKSPACE/kubeconfig-dev"
                          aws eks update-kubeconfig --name dev-eks --region $AWS_REGION --kubeconfig "$KUBECONFIG"

                          # 1. Delete the root app: Argo CD cascades to demo-app, then to the Deployment + Service
                          kubectl delete application root -n argocd --ignore-not-found --wait=true --timeout=5m

                          # 2. Wait (max 5 min) until no Service of type LoadBalancer is left
                          for i in $(seq 1 30); do
                            LBS=$(kubectl get svc -A -o jsonpath='{range .items[?(@.spec.type=="LoadBalancer")]}{.metadata.namespace}/{.metadata.name} {end}')
                            [ -z "$LBS" ] && break
                            echo "Waiting for load balancer services to be deleted: $LBS"
                            sleep 10
                          done
                          [ -z "$LBS" ] || { echo "Load balancers still present: $LBS"; exit 1; }

                          # 3. Give AWS time to delete the load balancers and their network interfaces
                          sleep 60
                        '''
                    }
                }
            }
        }
    stages {
        stage('Destroy dev') {
            steps {
                sh 'mkdir -p "$TF_PLUGIN_CACHE_DIR"'
                sh 'terraform -chdir=envs/dev init -input=false -reconfigure -no-color'
                script {
                    def count = sh(script: 'terraform -chdir=envs/dev state list | wc -l', returnStdout: true).trim()
                    if (count == '0') {
                        echo 'dev is already destroyed - nothing to do.'
                    } else {
                        sh 'terraform -chdir=envs/dev destroy -auto-approve -lock-timeout=5m -no-color'
                    }
                }
            }
        }
    }
}
